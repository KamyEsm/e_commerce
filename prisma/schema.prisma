// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Size {
  Xsmall
  small
  medium
  large
  Xlarge
  XXlarge
  XXXlarge
  XXXXlarge
}

enum Color {
  red
  yellow
  blue
  orange
  black
  white
  purple
  pink
}

model Member {
  id          Int            @id @default(autoincrement())
  firstname   String
  lastname    String
  Email       String         @unique
  Address     String
  hasshedPass String
  roles       RoleOnMember[]

  favorites Favorite[]
}

model Role {
  id      Int            @id @default(autoincrement())
  name    String
  desc    String
  members RoleOnMember[]
}

model RoleOnMember {
  member   Member @relation(fields: [memberId], references: [id])
  memberId Int
  role     Role   @relation(fields: [roleId], references: [id])
  roleId   Int

  assignedAt DateTime @default(now())

  @@id([memberId, roleId])
}

model Category {
  id       Int       @id @default(autoincrement())
  name     String
  desc     String
  iconURL  String
  products Product[]
}

model Product {
  id                  Int                   @id @default(autoincrement())
  name                String
  ImageURL            String?
  price               Float
  size                Size                  @default(medium)
  color               Color                 @default(red)
  category            Category              @relation(fields: [categoryId], references: [id])
  categoryId          Int
  favorites           Favorite[]
  heroBanners         HeroBanner[]
  productsOnCampaigns ProductsOnCampaigns[]
}

model Favorite {
  product   Product @relation(fields: [productId], references: [id])
  productId Int
  member    Member  @relation(fields: [memberId], references: [id])
  memberId  Int

  @@id([memberId, productId])
}

model HeroBanner {
  id           Int     @id @default(autoincrement())
  title        String
  imageURL     String
  brandIconURL String?
  product      Product @relation(fields: [productId], references: [id])
  productId    Int
  bgColor      String
  textColor    String
}

model Campaign {
  id                  Int                   @id @default(autoincrement())
  title               String
  startDate           DateTime
  endDate             DateTime
  priority            Int                   @default(0)
  productsOnCampaigns ProductsOnCampaigns[]
}

model ProductsOnCampaigns {
  product      Product  @relation(fields: [productId], references: [id])
  campaign     Campaign @relation(fields: [campaignId], references: [id])
  productId    Int
  campaignId   Int
  discountRate Int

  @@id([productId, campaignId])
}
